# ==============================================================================
# Nexora — SaaS Imobiliário com IA, CRM Conversacional e Follow-up
# Environment Variables Example (NO SECRETS COMMITTED)
# ==============================================================================

# Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Web App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nexora_dev

# Supabase Auth & Storage (Local / Remote)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-for-local-dev-only
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-for-local-dev-only
# Segredo HS256 do Supabase Auth. A API NAO sobe em producao sem um valor real.
SUPABASE_JWT_SECRET=placeholder-jwt-secret-at-least-32-chars-long
# Audience esperada nos tokens (padrao do Supabase: authenticated)
SUPABASE_JWT_AUD=authenticated

# Security / Session
SESSION_SECRET=placeholder-session-secret-change-in-production

# Messaging Gateway (Webhooks & Provider Secrets)
# Token do handshake de verificacao da Meta (GET). Sem valor real, a rota recusa.
WEBHOOK_SECRET=placeholder-webhook-secret-token
# App Secret da Meta: assina os webhooks de WhatsApp Cloud e Instagram (HMAC-SHA256).
META_APP_SECRET=placeholder-meta-app-secret
# Token compartilhado das conexoes Evolution que nao tiverem segredo proprio
# em channel_connections.settings_json.webhook_secret
EVOLUTION_WEBHOOK_TOKEN=placeholder-evolution-webhook-token

# Evolution API / WhatsApp Provider (MVP Local Testing)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=placeholder-evolution-api-key

# AI Provider (OpenAI / Gemini / Anthropic)
AI_PROVIDER=gemini
GEMINI_API_KEY=placeholder-gemini-api-key
OPENAI_API_KEY=placeholder-openai-api-key
ANTHROPIC_API_KEY=placeholder-anthropic-api-key

# n8n Orchestrator (Auxiliary Workflows)
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=placeholder-n8n-api-key
